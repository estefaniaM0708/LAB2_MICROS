from machine import Pin, ADC, DAC, I2C
from time import sleep_ms, ticks_ms, ticks_diff
from i2c_lcd import I2cLcd
from keypad import Keypad

# LCD I2C
i2c = I2C(
    0,
    scl=Pin(22),
    sda=Pin(21),
    freq=400000
)

lcd = I2cLcd(
    i2c,
    0x27,
    2,
    16
)

# TECLADO 4x4
filas = [
    Pin(13, Pin.OUT),
    Pin(12, Pin.OUT),
    Pin(14, Pin.OUT),
    Pin(27, Pin.OUT)
]

columnas = [
    Pin(19, Pin.IN, Pin.PULL_DOWN),
    Pin(18, Pin.IN, Pin.PULL_DOWN),
    Pin(5, Pin.IN, Pin.PULL_DOWN),
    Pin(17, Pin.IN, Pin.PULL_DOWN)
]

teclas = [

    ['1','2','3','A'],
    ['4','5','6','B'],
    ['7','8','9','C'],
    ['*','0','#','D']

]


teclado = Keypad(
    filas,
    columnas,
    teclas
)

# ADC - LM331

adc = ADC(
    Pin(35)
)

adc.atten(
    ADC.ATTN_11DB
)

adc.width(
    ADC.WIDTH_12BIT
)

# DAC - CONTROL MOTOR
dac = DAC(
    Pin(25)
)

dac.write(0)

# ENCODER

encoderA = Pin(
    32,
    Pin.IN
)

encoderB = Pin(
    26,
    Pin.IN
)


# CALIBRACIÓN

PENDIENTE_RPM = 769.0
INTERCEPTO_RPM = -153.0
RPM_MIN = 0
RPM_MAX = 3000


# VARIABLES
rpmMedida = 0
rpmDeseada = 0
rpmPromedio = 0

bufferEntrada = ""

# CONTROL PI

kp = 0.25
ki = 0.02

errorAcumulado = 0

salidaDAC = 0

DUTY_MIN = 40
DUTY_MAX = 255

# TIEMPO

ultimaLectura = ticks_ms()

PERIODO = 200

tiempoArranque = ticks_ms()

faseArranque = True

# FILTRO PROMEDIO MOVIL

NUM_MUESTRAS = 10

muestras = [0]*NUM_MUESTRAS

indice = 0

# SETUP

lcd.clear()

lcd.move_to(0,0)

lcd.putstr(
    "Control RPM"
)

lcd.move_to(0,1)

lcd.putstr(
    "Ingrese RPM #"
)

sleep_ms(1500)

lcd.clear()

# FUNCIONES

def leer_velocidad():

    global rpmMedida
    global rpmPromedio
    global indice


    lectura = adc.read()

    if lectura < 100:
        lectura = 0

    voltaje = (
        lectura / 4095
    ) * 3.3

    if lectura == 0:
        rpmMedida = 0

    else:

        rpmMedida = (
            PENDIENTE_RPM *
            voltaje
            +
            INTERCEPTO_RPM
        )

    if rpmMedida < 0:
        rpmMedida = 0

    if rpmMedida > RPM_MAX:
        rpmMedida = RPM_MAX

    muestras[indice] = rpmMedida

    indice = (
        indice + 1
    ) % NUM_MUESTRAS

    suma = 0

    for dato in muestras:
        suma += dato

    rpmPromedio = (
        suma /
        NUM_MUESTRAS
    )

    print(
        "ADC:",
        lectura,
        "RPM:",
        rpmPromedio
    )

def aplicar_control():
    global salidaDAC
    global errorAcumulado
    global faseArranque

    if rpmDeseada <= 10:
        dac.write(0)
        errorAcumulado = 0
        return

    error = (
        rpmDeseada -
        rpmPromedio
    )

    dt = (
        PERIODO /
        1000
    )

    errorAcumulado += (
        error *
        dt
    )

    if errorAcumulado > 500:
        errorAcumulado = 500

    if errorAcumulado < -500:
        errorAcumulado = -500

    if rpmDeseada < 600:
        offset = 130

    else:

        offset = 110

    control = (

        kp *
        error

    ) + (

        ki *
        errorAcumulado

    )

    if control > 0:

        salidaDAC = (
            offset +
            control
        )

    else:

        salidaDAC = 0

    # impulso inicial

    if (

        faseArranque and
        rpmPromedio < 400 and
        ticks_diff(
            ticks_ms(),
            tiempoArranque
        ) < 2000

    ):

        salidaDAC = 200

    else:

        faseArranque = False

    # histéresis

    if (

        rpmPromedio > 200
        and rpmDeseada > 0
        and salidaDAC < 80

    ):

        salidaDAC = 80
    dutyMin = DUTY_MIN
    if rpmDeseada < 600:
        dutyMin = 100
    if (

        rpmDeseada > 0
        and salidaDAC < dutyMin

    ):
        salidaDAC = dutyMin

    if salidaDAC > DUTY_MAX:
        salidaDAC = DUTY_MAX

    dac.write(
        int(salidaDAC)
    )

def manejar_tecla(tecla):

    global bufferEntrada
    global rpmDeseada
    global errorAcumulado
    global faseArranque
    global tiempoArranque

    if tecla >= '0' and tecla <= '9':

        bufferEntrada += tecla

    elif tecla == '#':

        if bufferEntrada != "":


            rpmDeseada = int(
                bufferEntrada
            )

            if rpmDeseada > RPM_MAX:

                rpmDeseada = RPM_MAX

            bufferEntrada = ""
            errorAcumulado = 0
            faseArranque = True
            tiempoArranque = ticks_ms()

    elif tecla == '*':

        bufferEntrada = ""

def actualizar_lcd():

    lcd.move_to(0,0)
    lcd.putstr(
        "RPM Act:"
    )

    lcd.putstr(
        str(int(rpmPromedio))
    )

    lcd.putstr(
        "   "
    )

    lcd.move_to(0,1)

    if bufferEntrada:

        lcd.putstr(
            "Set:"
            +
            bufferEntrada
            +
            " RPM"
        )

    else:

        lcd.putstr(
            "Des:"
            +
            str(int(rpmDeseada))
            +
            " RPM"
        )


def leer_direccion():

    a = encoderA.value()
    b = encoderB.value()

    if a == b:

        print(
            "Direccion Horario"
        )

    else:

        print(
            "Direccion Antihorario"
        )

# LOOP PRINCIPAL
while True:

    tecla = teclado.get_key()

    if tecla:

        manejar_tecla(
            tecla
        )

    if ticks_diff(

        ticks_ms(),
        ultimaLectura

    ) >= PERIODO:

        ultimaLectura = ticks_ms()

        leer_velocidad()
        aplicar_control()
        leer_direccion()
        actualizar_lcd()

    sleep_ms(10)
